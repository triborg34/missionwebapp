# Copy to server/.env (the server reads it from its working directory) and adjust.

# SQLite database file (relative to server/prisma/)
DATABASE_URL="file:./dev.db"

NODE_ENV=production
PORT=4000

# Directory for uploaded images, mission PDF assets and frozen approval copies.
# Keep it outside the web root and back it up with the database.
STORAGE_DIR=../storage
CLIENT_DIST_DIR=../client/dist

# Sessions
SESSION_TTL_HOURS=8
IDLE_TIMEOUT_MINUTES=60

# Set to true when served over HTTPS (required in production)
COOKIE_SECURE=true

# Number of reverse-proxy hops in front of the app (1 when behind Nginx)
TRUST_PROXY=1

# Path to Chrome/Chromium/Edge used for PDF rendering (optional; auto-detected if empty)
CHROME_PATH=

# Required for first-run setup in production. Enter it on the setup page once.
# Generate with: openssl rand -hex 24
SETUP_TOKEN=
